[Unit]
Description=FireDash PDF sanitizer broker (per connection, instance %i)
PartOf=fire-pdf-sanitizer-broker.socket

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/lib/fire-backend/fire-pdf-sanitizer-broker
StandardInput=socket
StandardOutput=inherit
StandardError=journal
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
PrivateNetwork=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/var/lib/fire-backend/sanitizer-output
