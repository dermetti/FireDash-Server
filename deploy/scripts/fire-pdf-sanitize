#!/bin/sh
# Root-owned UUID-only authorization wrapper. It never accepts caller paths or commands.
set -eu

[ "$#" -eq 1 ] || exit 64
job=$1
case "$job" in
    ????????-????-????-????-????????????) ;;
    *) exit 64 ;;
esac

case "$job" in *[!0123456789abcdef-]*|*[A-F]*) exit 64 ;; esac

unit="fire-pdf-sanitizer@${job}.service"
output="/var/lib/fire-backend/sanitizer-output/${job}/sanitized.pdf"

/bin/systemctl start --wait "$unit"
[ -f "$output" ] && [ ! -L "$output" ] || exit 1
[ "$(stat -c %s "$output")" -le 157286400 ] || exit 1
chown fire_backend:fire_backend "$output"
chmod 0600 "$output"
