#!/bin/sh
# This wrapper never falls back to an unrestricted qpdf invocation.
set -eu

input=${1:?input path required}
output=${2:?output path required}
timeout=${3:?timeout required}
memory_max=${4:?memory limit required}
case "$input:$output" in
    /var/lib/fire-backend/quarantine/*.pdf:/var/lib/fire-backend/sanitizer-output/*/sanitized.pdf) ;;
    *) exit 64 ;;
esac
case "$timeout:$memory_max" in
    *[!0-9:]*|:*|0:*|*:0) exit 64 ;;
esac

job=$(basename "$(dirname "$output")")
exec /usr/bin/systemd-run --quiet --wait --collect --service-type=exec \
    --unit="fire-pdf-sanitize-${job}" \
    --property=User=fire_pdf_sanitizer \
    --property=Group=fire_pdf_sanitizer \
    --property=NoNewPrivileges=yes \
    --property=PrivateNetwork=yes \
    --property=PrivateDevices=yes \
    --property=ProtectSystem=strict \
    --property=ProtectHome=yes \
    --property=RestrictAddressFamilies=AF_UNIX \
    --property=TasksMax=32 \
    --property="MemoryMax=${memory_max}" \
    --property=CPUQuota=100% \
    --property="TimeoutStartSec=${timeout}s" \
    --property="BindReadOnlyPaths=${input}:/run/fire-pdf-sanitizer/input.pdf" \
    --property="BindPaths=$(dirname "$output"):/run/fire-pdf-sanitizer/output" \
    /usr/bin/qpdf --deterministic-id --object-streams=disable \
    /run/fire-pdf-sanitizer/input.pdf /run/fire-pdf-sanitizer/output/sanitized.pdf
