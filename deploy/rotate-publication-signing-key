#!/usr/bin/env bash
# Root-only, two-phase Ed25519 publication signing-key rotation.
set -Eeuo pipefail
umask 077

SELF_DIR=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=lib/common.sh
source "$SELF_DIR/lib/common.sh"

RING_FILE="$SECRET_DIR/publication-signing-public-key-ring.json"
ACTIVE_PRIVATE="$SECRET_DIR/publication-signing-key"
ACTIVE_PUBLIC="$SECRET_DIR/publication-signing-public-key"
STAGING_ROOT="$SECRET_DIR/publication-signing-key-staging"
RELEASE=${FIREDASH_RELEASE:-$(readlink -f "$CURRENT_LINK" 2>/dev/null || true)}

PREPARE_WORKDIR=""
PREPARE_CANDIDATE=""
ACTIVATION_BACKUP=""

cleanup_temporary_material() {
    local status=$?
    trap - EXIT
    [[ -n $PREPARE_WORKDIR && -e $PREPARE_WORKDIR ]] && rm -rf -- "$PREPARE_WORKDIR"
    [[ -n $PREPARE_CANDIDATE && -e $PREPARE_CANDIDATE ]] && rm -f -- "$PREPARE_CANDIDATE"
    [[ -n $ACTIVATION_BACKUP && -e $ACTIVATION_BACKUP ]] && rm -rf -- "$ACTIVATION_BACKUP"
    exit "$status"
}
trap cleanup_temporary_material EXIT

usage() {
    cat >&2 <<'EOF'
Usage: rotate-publication-signing-key {prepare|activate} --version N
       rotate-publication-signing-key status
EOF
    exit 2
}

require_release() {
    [[ -n $RELEASE && -x $RELEASE/venv/bin/python ]] || die "current release Python is unavailable"
}

valid_version() { [[ ${1:-} =~ ^[1-9][0-9]*$ && ${#1} -le 64 ]]; }
stage_dir() { printf '%s/%s' "$STAGING_ROOT" "$1"; }

# ``install_file_atomic`` is appropriate for normal convergence, but this
# destructive-sensitive helper also needs to remove its destination-local temp
# file when an atomic rename fails. No caller ever opens the real destination
# for output before its complete source has been validated.
replace_file_atomically() {
    local source=$1 destination=$2 mode=$3 owner=$4 temporary
    temporary=$(mktemp "${destination}.rotation.XXXXXX") || return 1
    if ! cat -- "$source" > "$temporary" \
        || ! chmod "$mode" "$temporary" \
        || ! chown "$owner" "$temporary"; then
        rm -f -- "$temporary"
        return 1
    fi
    if ! mv -f -- "$temporary" "$destination"; then
        rm -f -- "$temporary"
        return 1
    fi
}

# Validate current active material and the complete retained public ring without
# printing any key bytes. Every Python block catches validation errors so a
# malformed credential cannot produce a traceback containing implementation
# detail or be mistaken for success by a surrounding shell conditional.
validate_current() {
    "$RELEASE/venv/bin/python" - "$ACTIVE_PRIVATE" "$ACTIVE_PUBLIC" "$RING_FILE" "$ENV_FILE" <<'PY'
import base64
import json
import re
import sys
from pathlib import Path

from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey

private, public, ring, env = map(Path, sys.argv[1:5])
version_re = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$")

def no_duplicates(pairs):
    result = {}
    for key, value in pairs:
        if key in result:
            raise ValueError("duplicate JSON member")
        result[key] = value
    return result

try:
    values = [
        line.split("=", 1)[1]
        for line in env.read_text("utf-8").splitlines()
        if line.startswith("PUBLICATION_SIGNING_KEY_VERSION=")
    ]
    if len(values) != 1 or not version_re.fullmatch(values[0]):
        raise ValueError("PUBLICATION_SIGNING_KEY_VERSION is invalid")
    private_value, public_value = private.read_bytes(), public.read_bytes()
    if len(private_value) != 32 or len(public_value) != 32:
        raise ValueError("active signing credentials must be 32 bytes")
    derived = Ed25519PrivateKey.from_private_bytes(private_value).public_key().public_bytes_raw()
    if derived != public_value:
        raise ValueError("active private/public signing pair does not match")
    document = json.loads(ring.read_text("ascii"), object_pairs_hook=no_duplicates)
    if not isinstance(document, dict) or set(document) != {"keys"} or not isinstance(document["keys"], dict):
        raise ValueError("public signing-key ring structure is invalid")
    for version, encoded in document["keys"].items():
        if not isinstance(version, str) or not version_re.fullmatch(version):
            raise ValueError("public signing-key ring version is invalid")
        if not isinstance(encoded, str):
            raise ValueError("public signing-key ring value is invalid")
        decoded = base64.b64decode(encoded.encode("ascii"), validate=True)
        if len(decoded) != 32:
            raise ValueError("public signing-key ring key must be 32 bytes")
    if document["keys"].get(values[0]) != base64.b64encode(public_value).decode("ascii"):
        raise ValueError("active public key is absent from its retained ring version")
except Exception as error:
    raise SystemExit(f"invalid current publication signing configuration: {error}") from None
PY
}

# This deliberately re-parses the ring after validate_current. It gives the
# duplicate-version error before any staging directory or candidate file is
# created, and detects an intervening malformed edit before mutation.
validate_prepare_request() {
    local version=$1
    "$RELEASE/venv/bin/python" - "$RING_FILE" "$version" <<'PY'
import base64
import json
import re
import sys
from pathlib import Path

ring, requested = Path(sys.argv[1]), sys.argv[2]
version_re = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$")

def no_duplicates(pairs):
    result = {}
    for key, value in pairs:
        if key in result:
            raise ValueError("duplicate JSON member")
        result[key] = value
    return result

try:
    document = json.loads(ring.read_text("ascii"), object_pairs_hook=no_duplicates)
    if not isinstance(document, dict) or set(document) != {"keys"} or not isinstance(document["keys"], dict):
        raise ValueError("public signing-key ring structure is invalid")
    keys = document["keys"]
    for version, encoded in keys.items():
        if not isinstance(version, str) or not version_re.fullmatch(version):
            raise ValueError("public signing-key ring version is invalid")
        if not isinstance(encoded, str) or len(base64.b64decode(encoded.encode("ascii"), validate=True)) != 32:
            raise ValueError("public signing-key ring entry is invalid")
    if requested in keys:
        raise ValueError(f"version {requested} is already retained")
except Exception as error:
    raise SystemExit(f"prepare validation failed: {error}") from None
PY
}

# Generate the private/public pair only in a root-only temporary directory and
# construct the candidate ring only in a separate temporary file. Neither is a
# live credential path. The candidate is subsequently parsed again before the
# live ring is atomically replaced.
generate_prepare_candidate() {
    local version=$1 workdir=$2 candidate=$3
    "$RELEASE/venv/bin/python" - "$RING_FILE" "$workdir" "$candidate" "$version" <<'PY'
import base64
import json
import os
import re
import sys
from pathlib import Path

from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey

ring, workdir, candidate = map(Path, sys.argv[1:4])
version = sys.argv[4]
version_re = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$")

def no_duplicates(pairs):
    result = {}
    for key, value in pairs:
        if key in result:
            raise ValueError("duplicate JSON member")
        result[key] = value
    return result

try:
    document = json.loads(ring.read_text("ascii"), object_pairs_hook=no_duplicates)
    if not isinstance(document, dict) or set(document) != {"keys"} or not isinstance(document["keys"], dict):
        raise ValueError("public signing-key ring structure is invalid")
    keys = document["keys"]
    if version in keys:
        raise ValueError(f"version {version} is already retained")
    for retained, encoded in keys.items():
        if not isinstance(retained, str) or not version_re.fullmatch(retained):
            raise ValueError("public signing-key ring version is invalid")
        if not isinstance(encoded, str) or len(base64.b64decode(encoded.encode("ascii"), validate=True)) != 32:
            raise ValueError("public signing-key ring entry is invalid")
    private = Ed25519PrivateKey.generate()
    private_value = private.private_bytes_raw()
    public_value = private.public_key().public_bytes_raw()
    if len(private_value) != 32 or len(public_value) != 32:
        raise ValueError("generated signing pair has invalid length")
    if Ed25519PrivateKey.from_private_bytes(private_value).public_key().public_bytes_raw() != public_value:
        raise ValueError("generated signing pair does not match")
    private_path, public_path = workdir / "private", workdir / "public"
    private_path.write_bytes(private_value)
    public_path.write_bytes(public_value)
    os.chmod(private_path, 0o600)
    os.chmod(public_path, 0o600)
    keys[version] = base64.b64encode(public_value).decode("ascii")
    candidate.write_text(json.dumps({"keys": keys}, sort_keys=True, separators=(",", ":")) + "\n", encoding="ascii")
    os.chmod(candidate, 0o600)
except Exception as error:
    raise SystemExit(f"could not generate publication signing-key candidate: {error}") from None
PY
}

validate_prepare_candidate() {
    local version=$1 workdir=$2 candidate=$3
    "$RELEASE/venv/bin/python" - "$workdir" "$candidate" "$version" <<'PY'
import base64
import json
import re
import sys
from pathlib import Path

from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey

workdir, candidate, version = Path(sys.argv[1]), Path(sys.argv[2]), sys.argv[3]
version_re = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$")

def no_duplicates(pairs):
    result = {}
    for key, value in pairs:
        if key in result:
            raise ValueError("duplicate JSON member")
        result[key] = value
    return result

try:
    private_value = (workdir / "private").read_bytes()
    public_value = (workdir / "public").read_bytes()
    if len(private_value) != 32 or len(public_value) != 32:
        raise ValueError("staged signing pair must be 32 bytes")
    if Ed25519PrivateKey.from_private_bytes(private_value).public_key().public_bytes_raw() != public_value:
        raise ValueError("staged private/public signing pair does not match")
    document = json.loads(candidate.read_text("ascii"), object_pairs_hook=no_duplicates)
    if not isinstance(document, dict) or set(document) != {"keys"} or not isinstance(document["keys"], dict):
        raise ValueError("candidate public signing-key ring structure is invalid")
    keys = document["keys"]
    for retained, encoded in keys.items():
        if not isinstance(retained, str) or not version_re.fullmatch(retained):
            raise ValueError("candidate public signing-key ring version is invalid")
        if not isinstance(encoded, str) or len(base64.b64decode(encoded.encode("ascii"), validate=True)) != 32:
            raise ValueError("candidate public signing-key ring entry is invalid")
    if keys.get(version) != base64.b64encode(public_value).decode("ascii"):
        raise ValueError("candidate public ring does not match staged public key")
except Exception as error:
    raise SystemExit(f"invalid publication signing-key candidate: {error}") from None
PY
}

safe_ring_metadata() {
    local ring=$1 active_version=$2
    "$RELEASE/venv/bin/python" - "$ring" "$active_version" <<'PY'
import base64
import hashlib
import json
import sys
from pathlib import Path

ring, active = Path(sys.argv[1]), sys.argv[2]
keys = json.load(ring.open(encoding="ascii"))["keys"]
print("public-key SHA-256: " + hashlib.sha256(base64.b64decode(keys[active], validate=True)).hexdigest())
print("retained public versions: " + ", ".join(sorted(keys, key=lambda value: int(value) if value.isdigit() else value)))
PY
}

prepare() {
    local version=$1 stage metadata
    valid_version "$version" || die "rotation version must be a positive integer"
    require_release
    if ! validate_current; then
        die "current signing credentials or public ring are invalid"
    fi
    if ! validate_prepare_request "$version"; then
        die "refusing to prepare publication signing-key version $version"
    fi
    stage=$(stage_dir "$version")
    [[ ! -e $stage ]] || die "version $version already has staged material; refusing overwrite"

    # All persistent mutations begin only after every input validation above.
    install -d -m 0700 -o root -g root "$STAGING_ROOT" || die "could not create signing-key staging root"
    PREPARE_WORKDIR=$(mktemp -d "$STAGING_ROOT/.prepare.XXXXXX") || die "could not create private staging directory"
    chmod 0700 "$PREPARE_WORKDIR" || die "could not secure private staging directory"
    PREPARE_CANDIDATE=$(mktemp "$SECRET_DIR/.publication-signing-public-key-ring.candidate.XXXXXX") || die "could not create public-ring candidate"
    chmod 0600 "$PREPARE_CANDIDATE" || die "could not secure public-ring candidate"
    if ! generate_prepare_candidate "$version" "$PREPARE_WORKDIR" "$PREPARE_CANDIDATE"; then
        die "could not prepare publication signing-key version $version"
    fi
    if ! validate_prepare_candidate "$version" "$PREPARE_WORKDIR" "$PREPARE_CANDIDATE"; then
        die "generated publication signing-key candidate is invalid"
    fi
    if ! metadata=$(safe_ring_metadata "$PREPARE_CANDIDATE" "$version"); then
        die "generated publication signing-key candidate has invalid metadata"
    fi
    [[ ! -e $stage ]] || die "version $version became staged during preparation; refusing overwrite"
    if ! mv "$PREPARE_WORKDIR" "$stage"; then
        die "could not commit private signing-key staging material"
    fi
    PREPARE_WORKDIR=""
    if ! replace_file_atomically "$PREPARE_CANDIDATE" "$RING_FILE" 0600 root:root; then
        rm -rf -- "$stage" || log_err "could not remove uncommitted signing-key staging material: $stage"
        die "could not atomically replace the public signing-key ring"
    fi
    rm -f -- "$PREPARE_CANDIDATE"
    PREPARE_CANDIDATE=""

    # LoadCredential snapshots its source at service start. The active signer
    # remains unchanged; only the public ring is refreshed for exact-version
    # endpoint verification before activation.
    if ! systemctl try-restart fire-backend.service; then
        die "public ring was prepared but fire-backend did not reload it; do not activate until it is reloaded and verified"
    fi
    log "prepared publication signing-key version $version"
    printf '%s\n' "$metadata"
    log "active signing credentials remain unchanged; verify the public ring before activation"
}

write_active_version() {
    local version=$1 output
    output=$(mktemp "$ENV_FILE.tmp.XXXXXX") || return 1
    if ! "$RELEASE/venv/bin/python" - "$ENV_FILE" "$version" > "$output" <<'PY'
import sys
from pathlib import Path

env, version = Path(sys.argv[1]), sys.argv[2]
try:
    lines = env.read_text("utf-8").splitlines()
    matches = [index for index, line in enumerate(lines) if line.startswith("PUBLICATION_SIGNING_KEY_VERSION=")]
    if len(matches) != 1:
        raise ValueError("PUBLICATION_SIGNING_KEY_VERSION is missing or duplicated")
    lines[matches[0]] = "PUBLICATION_SIGNING_KEY_VERSION=" + version
    print("\n".join(lines))
except Exception as error:
    raise SystemExit(f"could not update active signing version: {error}") from None
PY
    then
        rm -f -- "$output"
        return 1
    fi
    if ! replace_file_atomically "$output" "$ENV_FILE" 0640 root:fire_backend; then
        rm -f -- "$output"
        return 1
    fi
    rm -f -- "$output"
}

validate_staged_activation() {
    local stage=$1 version=$2
    "$RELEASE/venv/bin/python" - "$stage/private" "$stage/public" "$RING_FILE" "$version" <<'PY'
import base64
import json
import sys
from pathlib import Path

from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey

private, public, ring, version = Path(sys.argv[1]), Path(sys.argv[2]), Path(sys.argv[3]), sys.argv[4]
try:
    private_value, public_value = private.read_bytes(), public.read_bytes()
    if len(private_value) != 32 or len(public_value) != 32:
        raise ValueError("staged signing pair must be 32 bytes")
    if Ed25519PrivateKey.from_private_bytes(private_value).public_key().public_bytes_raw() != public_value:
        raise ValueError("staged private/public signing pair does not match")
    keys = json.load(ring.open(encoding="ascii"))["keys"]
    if keys.get(version) != base64.b64encode(public_value).decode("ascii"):
        raise ValueError("staged public key does not match retained ring entry")
except Exception as error:
    raise SystemExit(f"invalid staged publication signing-key version {version}: {error}") from None
PY
}

restart_publication_services() {
    local failed=0
    systemctl enable --now fire-publication-build.socket || failed=1
    systemctl enable --now fire-publication-build.timer || failed=1
    systemctl enable --now fire-publication-delivery.service || failed=1
    return "$failed"
}

quiesce_publication_services() {
    # Stop activation sources as well as a running build so a socket/timer
    # cannot start a signer while its active credentials are being exchanged.
    if ! systemctl stop fire-publication-build.timer \
        || ! systemctl stop fire-publication-build.socket \
        || ! systemctl stop fire-publication-build.service \
        || ! systemctl stop fire-publication-delivery.service; then
        restart_publication_services || true
        return 1
    fi
}

restore_active() {
    local backup=$1 failed=0
    replace_file_atomically "$backup/private" "$ACTIVE_PRIVATE" 0600 root:root || failed=1
    replace_file_atomically "$backup/public" "$ACTIVE_PUBLIC" 0600 root:root || failed=1
    replace_file_atomically "$backup/fire-backend.env" "$ENV_FILE" 0640 root:fire_backend || failed=1
    restart_publication_services || failed=1
    return "$failed"
}

fail_activation() {
    local backup=$1 reason=$2
    log_err "$reason; restoring previously active signing credentials"
    if restore_active "$backup"; then
        rm -rf -- "$backup"
        ACTIVATION_BACKUP=""
        die "activation failed safely; prior active credentials and worker state restored"
    fi
    # Retain the root-only backup for a human recovery if the automatic restore
    # itself failed; the EXIT trap must not erase the only known-good active
    # pair in this exceptional state.
    ACTIVATION_BACKUP=""
    die "activation failed and automatic recovery could not fully restore prior credentials/services; backup retained at $backup; stop and investigate without editing historical ring entries"
}

activate() {
    local version=$1 stage current_version metadata
    valid_version "$version" || die "rotation version must be a positive integer"
    require_release
    if ! validate_current; then
        die "current signing credentials or public ring are invalid"
    fi
    stage=$(stage_dir "$version")
    [[ -f $stage/private && -f $stage/public ]] || die "version $version is not prepared"
    if ! validate_staged_activation "$stage" "$version"; then
        die "refusing to activate invalid staged publication signing-key version $version"
    fi
    current_version=$(env_value "$ENV_FILE" PUBLICATION_SIGNING_KEY_VERSION)
    if [[ $current_version == "$version" ]]; then
        if cmp -s "$ACTIVE_PRIVATE" "$stage/private" && cmp -s "$ACTIVE_PUBLIC" "$stage/public"; then
            log "version $version is already active; no change"
            return
        fi
        die "version $version is active but differs from staged material"
    fi
    if ! metadata=$(safe_ring_metadata "$RING_FILE" "$version"); then
        die "retained public signing-key metadata is invalid"
    fi

    ACTIVATION_BACKUP=$(mktemp -d "$STAGING_ROOT/.activate.XXXXXX") || die "could not create activation backup"
    chmod 0700 "$ACTIVATION_BACKUP" || die "could not secure activation backup"
    install -m 0600 -o root -g root "$ACTIVE_PRIVATE" "$ACTIVATION_BACKUP/private" || die "could not back up active private signing key"
    install -m 0600 -o root -g root "$ACTIVE_PUBLIC" "$ACTIVATION_BACKUP/public" || die "could not back up active public signing key"
    install -m 0640 -o root -g fire_backend "$ENV_FILE" "$ACTIVATION_BACKUP/fire-backend.env" || die "could not back up active environment"
    if ! quiesce_publication_services; then
        die "could not quiesce publication services; active credentials are unchanged"
    fi
    if ! replace_file_atomically "$stage/private" "$ACTIVE_PRIVATE" 0600 root:root; then
        fail_activation "$ACTIVATION_BACKUP" "could not replace active private signing key"
    fi
    if ! replace_file_atomically "$stage/public" "$ACTIVE_PUBLIC" 0600 root:root; then
        fail_activation "$ACTIVATION_BACKUP" "could not replace active public signing key"
    fi
    if ! write_active_version "$version"; then
        fail_activation "$ACTIVATION_BACKUP" "could not update active signing version"
    fi
    if ! validate_current; then
        fail_activation "$ACTIVATION_BACKUP" "new active signing configuration did not validate"
    fi
    if ! restart_publication_services; then
        fail_activation "$ACTIVATION_BACKUP" "publication services did not restart"
    fi
    rm -rf -- "$ACTIVATION_BACKUP"
    ACTIVATION_BACKUP=""
    log "activated publication signing-key version $version"
    printf '%s\n' "$metadata"
    log "staged material retained at $stage; remove it only after the documented retention review"
}

status() {
    require_release
    if ! validate_current; then
        die "current signing credentials or public ring are invalid"
    fi
    "$RELEASE/venv/bin/python" - "$ACTIVE_PUBLIC" "$RING_FILE" "$ENV_FILE" "$STAGING_ROOT" <<'PY'
import base64
import hashlib
import json
import sys
from pathlib import Path

public, ring, env, staging = map(Path, sys.argv[1:5])
active = next(
    line.split("=", 1)[1]
    for line in env.read_text("utf-8").splitlines()
    if line.startswith("PUBLICATION_SIGNING_KEY_VERSION=")
)
keys = json.load(ring.open(encoding="ascii"))["keys"]
active_key = public.read_bytes()
print("active version: " + active)
print("active public matches ring: " + ("yes" if keys.get(active) == base64.b64encode(active_key).decode("ascii") else "no"))
for version in sorted(keys, key=lambda value: int(value) if value.isdigit() else value):
    print(f"public version {version}: sha256={hashlib.sha256(base64.b64decode(keys[version], validate=True)).hexdigest()}")
staged = sorted(path.name for path in staging.iterdir() if path.is_dir()) if staging.is_dir() else []
print("staged versions: " + (", ".join(staged) if staged else "none"))
PY
}

require_root
[[ $# -ge 1 ]] || usage
case "$1" in
    prepare|activate) [[ $# -eq 3 && $2 == --version ]] || usage; "$1" "$3" ;;
    status) [[ $# -eq 1 ]] || usage; status ;;
    *) usage ;;
esac
